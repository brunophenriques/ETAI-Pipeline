{
  "dataset_sha256": "6a747fd4a04d545976510401695587984a06662ea319b614fbf079b61201161a",
  "data": {
    "path": "data/compas_two_year_recidivism.csv",
    "target": "two_year_recid",
    "sensitive_attr": "race",
    "drop_columns": [
      "id",
      "decile_score",
      "score_text"
    ]
  },
  "preprocessing": {
    "engineered_features": {
      "enabled": true
    },
    "scaler": "standard",
    "numerical_imputation": "median",
    "n_neighbors": 5,
    "categorical_imputation": "most_frequent",
    "missing_indicator_columns": [
      "priors_count",
      "c_charge_degree"
    ],
    "extra_columns_to_impute": [
      "race"
    ]
  },
  "split": {
    "test_size": 0.2,
    "random_state": 42
  },
  "cv": {
    "n_splits": 5,
    "shuffle": true,
    "random_state": 42,
    "metrics": [
      "accuracy",
      "balanced_accuracy",
      "precision",
      "recall",
      "f1",
      "fbeta_2",
      "roc_auc",
      "average_precision"
    ],
    "selection_metric": "roc_auc",
    "n_jobs": -1
  },
  "model": {
    "type": "xgboost",
    "params": {
      "random_state": 42,
      "n_jobs": 1,
      "tree_method": "hist",
      "eval_metric": "logloss"
    }
  },
  "trials": 15,
  "inner_folds": 5,
  "sampler_seed": 42,
  "selection": {
    "enabled": true,
    "min_votes": 2,
    "random_state": 42,
    "search_space": {
      "select__min_votes": {
        "type": "int",
        "low": 1,
        "high": 3
      }
    }
  },
  "search_space": {
    "classifier__n_estimators": {
      "type": "int",
      "low": 25,
      "high": 500,
      "log": true
    },
    "classifier__learning_rate": {
      "type": "float",
      "low": 0.01,
      "high": 0.3,
      "log": true
    },
    "classifier__max_depth": {
      "type": "int",
      "low": 2,
      "high": 8
    },
    "classifier__min_child_weight": {
      "type": "float",
      "low": 1.0,
      "high": 50.0,
      "log": true
    },
    "classifier__gamma": {
      "type": "float",
      "low": 0.0,
      "high": 5.0
    },
    "classifier__reg_alpha": {
      "type": "float",
      "low": 1e-08,
      "high": 10.0,
      "log": true
    },
    "classifier__reg_lambda": {
      "type": "float",
      "low": 0.001,
      "high": 100.0,
      "log": true
    },
    "classifier__subsample": {
      "type": "float",
      "low": 0.6,
      "high": 1.0
    },
    "classifier__colsample_bytree": {
      "type": "float",
      "low": 0.5,
      "high": 1.0
    }
  },
  "versions": {
    "sklearn": "1.9.1",
    "xgboost": "3.4.1",
    "optuna": "5.0.0"
  }
}